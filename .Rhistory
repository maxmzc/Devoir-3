n_blocks = 1, epochs = c(50000L, 100000L), stringsAsFactors = FALSE)
res_replication <- run_experiments(replication, grid, G, n_sim)
# ---- 2. QL vs SARSA : niveaux d'exploration et d'apprentissage, alpha constant ou décroissant ----
comparison <- expand.grid(method = c("QL", "SARSA"), epsilon = c(0.1, 0.3, 0.5), alpha = c(0.1, 0.5),
n_blocks = c(1, 10), epochs = 50000L, stringsAsFactors = FALSE)
res_comparison <- run_experiments(comparison, grid, G, n_sim)
# ---- Résultats ----
cat("\nÉtalon DP (article) :", dp_benchmark, "\n")
cat("\n1. Réplication du tableau 1 (in-sample) et tests hors échantillon\n")
print(res_replication, digits = 3, row.names = FALSE)
cat("\n2. QL vs SARSA, hors échantillon\n")
print(res_comparison, digits = 3, row.names = FALSE)
plot_learning_curves(runs, dp_benchmark, "outputs/1_courbes_apprentissage.pdf")
source("graphs.R")
plot_learning_curves(runs, dp_benchmark, "outputs/1_courbes_apprentissage.pdf")
plot_oos_vs_epsilon(res_comparison, dp_benchmark, "outputs/2_succes_vs_epsilon.pdf")
plot_policy_maps(runs, grid, G, "outputs/3_cartes_politique.pdf")
# ---- 3. Courbes d'apprentissage : QL et SARSA, alpha constant ou décroissant ----
curve_cases <- expand.grid(method = c("QL", "SARSA"), n_blocks = c(1, 10), stringsAsFactors = FALSE)
runs <- run_learning_curves(curve_cases, grid, G, epochs = 100000L, epsilon = 0.3, alpha = 0.1,
checkpoint_every = 5000L, n_sim = 2000)
# Devoir 3 : GBWM par Q-learning et SARSA (Das et Varma, 2020)
# Routine principale : produit les tableaux et les graphiques (dossier outputs/) du rapport.
# Durée d'exécution par défaut : environ 4 minutes. Réduire `epochs`, `n_sim` ou `n_reps` pour aller plus vite.
#
# Exemples d'appels des fonctions (voir functions.R) :
#   grid <- build_grid(w0 = 100, horizon = 10, mu_vals, sig_vals, n_w = 101)
#   Q    <- train(grid, G = 200, epochs = 50000, epsilon = 0.3, alpha = 0.1, method = "SARSA", n_blocks = 10)$Q
#   evaluate_policy(Q, grid, G = 200, n_sim = 10000)
rm(list = ls())
source("functions.R")
source("graphs.R")
set.seed(2026)                                 # résultats reproductibles
dir.create("outputs", showWarnings = FALSE)
# ---- Paramètres du problème (article, tableau 1, p. 17) ----
w0 <- 100                                      # richesse initiale
G <- 200                                       # objectif
horizon <- 10                                  # horizon en années
n_w <- 101                                     # nombre de noeuds de la grille de richesse
mu_vals <- c(0.0526, 0.0552, 0.0577, 0.0603, 0.0629, 0.0655, 0.0680,
0.0706, 0.0732, 0.0757, 0.0783, 0.0809, 0.0835, 0.0860, 0.0886)
sig_vals <- c(0.0485, 0.0486, 0.0493, 0.0508, 0.0529, 0.0556, 0.0587,
0.0623, 0.0662, 0.0705, 0.0749, 0.0796, 0.0844, 0.0894, 0.0945)
dp_benchmark <- 0.72                           # solution DP de l'article (étalon)
n_sim <- 10000                                 # trajectoires pour les tests hors échantillon
n_reps <- 3                                    # répétitions par configuration (section 2)
grid <- build_grid(w0, horizon, mu_vals, sig_vals, n_w)
# ---- 1. Réplication in-sample du tableau 1 (QL, alpha = 0.1 constant) + tests hors échantillon ----
replication <- expand.grid(method = "QL", epsilon = c(0.1, 0.2, 0.3, 0.4), alpha = 0.1,
n_blocks = 1, epochs = c(50000L, 100000L), stringsAsFactors = FALSE)
res_replication <- run_experiments(replication, grid, G, n_sim)
# ---- 2. QL vs SARSA : niveaux d'exploration et d'apprentissage (alpha décroissant), n_reps répétitions ----
comparison <- expand.grid(method = c("QL", "SARSA"), epsilon = c(0.1, 0.3, 0.5), alpha = c(0.1, 0.5),
n_blocks = 10, epochs = 50000L, rep = 1:n_reps, stringsAsFactors = FALSE)
res_comparison <- run_experiments(comparison, grid, G, n_sim)
mean_comparison <- aggregate(cbind(in_sample, oos_greedy, oos_explore) ~ method + epsilon + alpha,
res_comparison, mean)
# ---- 3. Courbes d'apprentissage : QL et SARSA, alpha constant ou décroissant ----
curve_cases <- expand.grid(method = c("QL", "SARSA"), n_blocks = c(1, 10), stringsAsFactors = FALSE)
runs <- run_learning_curves(curve_cases, grid, G, epochs = 100000L, epsilon = 0.3, alpha = 0.1,
checkpoint_every = 5000L, n_sim = 2000)
# ---- Résultats ----
cat("\nÉtalon DP (article) :", dp_benchmark, "\n")
cat("\n1. Réplication du tableau 1 (in-sample) et tests hors échantillon\n")
print(res_replication, digits = 3, row.names = FALSE)
cat("\n2. QL vs SARSA, moyennes sur", n_reps, "répétitions\n")
print(mean_comparison, digits = 3, row.names = FALSE)
plot_learning_curves(runs, dp_benchmark, "outputs/1_courbes_apprentissage.pdf")
plot_oos_vs_epsilon(res_comparison, dp_benchmark, "outputs/2_succes_vs_epsilon.pdf")
plot_policy_maps(runs, grid, G, "outputs/3_cartes_politique.pdf")
plot_learning_curves(runs, dp_benchmark, "outputs/1_courbes_apprentissage.pdf")
plot_learning_curves(runs, dp_benchmark, "outputs/1_courbes_apprentissage.pdf")
