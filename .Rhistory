Y_last20 <- tail(Y, 21)
fit_final <- VAR(Y_last20, p = lags, type = "const")
summary(fit_final)
# data = all VAR variables (Δy_t, Δc_t, Δi_t, Δg_t)
data  <- Y
lags <- p_opt                    # from part (b), here p_opt = 4
n    <- nrow(data)
begin      <- 1                  # first observation in-sample
end        <- n                  # last observation
begin_oosf <- end - 20 + 1       # first OOS obs = last 20 quarters (2015Q1)
# Number of OOS forecasts (should be 20)
T_oos <- end - begin_oosf + 1
# Storage for Δy_τ* and forecast errors Δy_τ − Δy_τ*
fc_dY <- rep(NA_real_, T_oos)
fe_dY <- rep(NA_real_, T_oos)
for (i in 1:T_oos) {
t <- begin_oosf + i - 1        # current forecast date index (2015Q1,...,2019Q4)
# 1) Re-estimate the VAR using all observations up to time τ−1
data_in  <- data[begin:(t - 1), ]
fit_τ   <- VAR(dat_in, p = lags, type = "const")
# 2) 1-quarter-ahead forecast Δy_τ* = E(Δy_τ | I_{τ−1})
fc1     <- predict(fit_τ, n.ahead = 1)$fcst
fc_dY[i] <- fc1$dYt[1, "fcst"]
# 3) Forecast error Δy_τ − Δy_τ*
fe_dY[i] <- dat[τ, "dYt"] - fc_dY[i]
}
