# Taux de succès hors échantillon : Q est figée, on simule n_sim nouvelles trajectoires
# de richesse en suivant la politique, et on compte la proportion qui atteint G à la fin
#   epsilon = 0 : politique gloutonne (aucune exploration) ; epsilon > 0 : on explore encore
evaluate_policy <- function(Q, grid, G, n_sim, epsilon = 0, seed = NULL) {
if (!is.null(seed)) set.seed(seed)
n_t <- dim(Q)[2] - 1                         # nb de dates de décision (horizon)
n_pf <- dim(Q)[3]                            # nb de portefeuilles
success <- logical(n_sim)
for (s in 1:n_sim) {
idx <- grid$start_idx                      # on repart de W0
for (t in 1:n_t) idx <- draw_next(grid, idx, t, get_action(Q, idx, t, epsilon, n_pf))
success[s] <- grid$w_array[idx] >= G       # objectif atteint à l'horizon ?
}
mean(success)
}
