# Importation des fonctions personnalisées et des données du cours
rm(list = ls())                                # clear all data and functions
library("here")
source(here("code cours", "TEC_QL_GBWM_build_grid.R"))
source(here("code cours", "TEC_QL_GBWM_solve_CANEVAS_complété2026.R"))
w0 <- 100                                      # initial wealth
G <- 200                                       # goal
T <- 10                                        # horizon
nw <- 101                                      # nb of wealth points
np <- 15                                       # nb of portfolios considered
epsi <- 0.3                                    # level of exploration (vs exploitation)
alpha <- 0.1                                 # Fix learning rate
seed <- 123
# Parameters of the efficient portfolios
mu_vals <- c(0.0526, 0.0552, 0.0577, 0.0603, 0.0629, 0.0655, 0.0680,
0.0706, 0.0732, 0.0757, 0.0783, 0.0809, 0.0835, 0.0860, 0.0886)
sig_vals <- c(0.0485, 0.0486, 0.0493, 0.0508, 0.0529, 0.0556, 0.0587,
0.0623, 0.0662, 0.0705, 0.0749, 0.0796, 0.0844, 0.0894, 0.0945)
# ---- Réplication table p.17 ----
# Définition des variables de la table
epochs_list <- c(50000L, 100000L, 200000L, 500000L) # 50K, 100K, 200K et 500K epochs par epsilon
epsilon_list <- c(0.10, 0.20, 0.25, 0.30, 0.40) # Tester des actions non optimales a priori
# Table des résultats
nrows = length(epsilon_list) * 2 + 2 # 2 epochs par epsilon sauf 0.40 qui a 4 epochs
table_17 <- matrix(NA,
nrow = nrows,
ncol = 3
)
colnames(table_17) <- c("\u03b5", "No. of epochs", "V[W(0), t = 0]")
rownames_table_17 <- c()
# Simulation des résultats pour chaque combinaison d'epsilon et d'epochs
for (i in seq_along(epsilon_list)) {
epsilon <- epsilon_list[i]
reps <- if (epsilon == 0.40) 4 else 2
for (j in 1:reps) {
epochs <- epochs_list[j]
start_time <- Sys.time()
result <- TEC_QL_GBWM_solve(w0, G, T, nw, np, mu_vals, sig_vals,
epochs, epsilon, alpha, seed)
end_time <- Sys.time()
elapsed_time <- as.numeric(difftime(end_time, start_time, units = "secs"))
suc_rl <- round(result[[1]], 2)
print(paste("Epsilon:", epsilon, "Epochs:", epochs, "V[W(0), t=0]:", suc_rl, "Time:", round(elapsed_time, 2), "seconds"))
table_17[(i - 1) * 2 + j, ] <- c(epsilon, epochs, suc_rl)
}
}
print(table_17)
